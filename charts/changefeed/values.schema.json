{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "config", "persistence"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" },
        "storageClass": { "type": "string" },
        "existingClaim": { "type": "string" },
        "accessModes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "listen": { "type": "string" },
        "publicURL": { "type": "string" },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "retention": { "type": "string", "pattern": "^[0-9]+(d|h|m)$" }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "anonymousRead": { "type": "boolean" },
            "tokens": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "sha256", "scopes"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
                  "scopes": { "type": "array", "minItems": 1, "items": { "enum": ["read", "write"] } },
                  "sources": { "type": "array", "items": { "type": "string" } },
                  "envs": { "type": "array", "items": { "type": "string" } },
                  "services": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "github": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "audience": { "type": "string" },
                "issuer": { "type": "string" },
                "repositories": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/([A-Za-z0-9_.-]+|\\*)$" } },
                "environments": { "type": "array", "items": { "type": "string" } }
              }
            },
            "rateLimit": {
              "type": "object",
              "properties": { "perMinute": { "type": "integer", "minimum": 0 } }
            },
            "oidc": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "issuer": { "type": "string" },
                "clientID": { "type": "string" },
                "redirectURL": { "type": "string" },
                "scopes": { "type": "array", "items": { "type": "string" } },
                "groupsClaim": { "type": "string" },
                "sessionTTL": { "type": "string" }
              }
            },
            "teams": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "groups"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "groups": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                  "envs": { "type": "array", "items": { "type": "string" } },
                  "services": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "collectors": {
          "type": "object",
          "properties": {
            "kubernetes": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "env": { "type": "string" },
                "cluster": { "type": "string" },
                "namespaces": { "type": "array", "items": { "type": "string" } },
                "ignoreNamespaces": { "type": "array", "items": { "type": "string" } },
                "watch": { "type": "array", "items": { "enum": ["deployments", "statefulsets", "daemonsets", "configmaps", "helm"] } },
                "configMapValues": { "type": "boolean" }
              }
            }
          }
        },
        "hooks": { "type": "object" },
        "services": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": { "dependsOn": { "type": "array", "items": { "type": "string" } } }
          }
        },
        "platformServices": { "type": "array", "items": { "type": "string" } },
      "slack": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "channel": { "type": "string" },
          "minScore": { "type": "integer", "minimum": 0, "maximum": 99 },
          "apiURL": { "type": "string" }
        }
      },
      "freezes": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "reason": { "type": "string" },
            "envs": { "type": "array", "items": { "type": "string" } },
            "services": { "type": "array", "items": { "type": "string" } },
            "start": { "type": "string" },
            "end": { "type": "string" },
            "weekly": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to"],
              "properties": {
                "from": { "type": "string", "pattern": "^(mon|tue|wed|thu|fri|sat|sun) [0-2][0-9]:[0-5][0-9]$" },
                "to": { "type": "string", "pattern": "^(mon|tue|wed|thu|fri|sat|sun) [0-2][0-9]:[0-5][0-9]$" },
                "timezone": { "type": "string" }
              }
            }
          }
        }
      }
      }
    },
    "existingSecret": { "type": "string" },
    "postgres": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "logFormat": { "enum": ["json", "text"] }
  }
}
